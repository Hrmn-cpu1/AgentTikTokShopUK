DATABASE_URL=postgresql+psycopg://operator:change-me@localhost:5432/tiktok_profit
OPERATOR_API_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
OPERATOR_LOGIN_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
TIKTOK_CLIENT_KEY=your-approved-developer-app-client-key
TIKTOK_CLIENT_SECRET=server-side-developer-app-client-secret
TIKTOK_REDIRECT_URI=https://your-domain.example/v1/tiktok/callback
TIKTOK_TOKEN_ENCRYPTION_KEY=generate-with-python-cryptography-fernet-generate_key
ANDROID_APP_SHA256_FINGERPRINTS=

# Cloud video generation (phone-first; inference never runs on Android)
VIDEO_PROVIDER=local
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_H3_MODEL=MiniMax-H3
MINIMAX_H3_RESOLUTION=768P
MINIMAX_H3_RATIO=9:16
MINIMAX_H3_TIMEOUT_SECONDS=600
MINIMAX_H3_POLL_INTERVAL_SECONDS=5
